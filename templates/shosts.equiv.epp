# shosts.equiv: Managed by Puppet
<% $allow_ips = $profile_hostbased_ssh::target::sshd_allow_ips -%>
<% $profile_hostbased_ssh::known_hosts::hosts_data.each | $host_set, $data | { -%>
# Hosts in <%= $host_set %>
<% $domain = $data[domain] -%>
<% $data[hosts].each | $host, $ip | { -%>
<%= $host %>
<% if $domain { -%>
<%= $host %>.<%= $domain %>
<% } -%>
<% if $allow_ips { -%>
<%= $ip %>
<% } -%>
<% } -%>

<% } -%>
